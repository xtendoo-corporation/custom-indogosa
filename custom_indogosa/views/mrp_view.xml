<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="name">mrp.bom.form - mrp_bom_location</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="xtendoo_mrp_bom_cost.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='bom_line_ids']/tree/field[@name='product_qty']"
                position="replace"
            >
                <field name="product_qty" context="{'uom': product_qty}"/>
            </xpath>

             <xpath
                expr="//div[@class='o_row']"
                position="after"
            >
                 <field name="total_bom_price"/>
             </xpath>
            <xpath
                expr="//field[@name='total_price']"
                position="replace"
            >
                 <field name="total_price" context="{'uom': total_price}"/>
            </xpath>
        </field>
    </record>

</odoo>
