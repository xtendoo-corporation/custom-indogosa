<odoo>
    <record id="view_mrp_production_form_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.weight.control</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']" position="after">
                <page name="weight_control" string="Weight Control">
                    <field name="weight_control_ids" context="{'default_production_id': id}">
                        <list editable="bottom" decoration-danger="is_weight_control == False">
                            <field name="employee_id"/>
                            <field name="weight"/>
                            <field name="minimum_weight" />
                            <field name="maximum_weight"/>
                            <field name="date" />
                            <field name="is_weight_control" widget="boolean" invisible="1" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
